# ============================================
# APPLICATION
# ============================================

APP_NAME=Palmistry & Tarot Intelligence Platform
APP_VERSION=4.0.0

APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO


# ============================================
# GEMINI
# ============================================

GEMINI_API_KEY=your_gemini_api_key_here

GEMINI_MODEL=your_working_gemini_model_here


# ============================================
# FRONTEND / CORS
# ============================================

FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173


# ============================================
# SECURITY
# ============================================

ALLOWED_HOSTS=127.0.0.1,localhost,testserver

MAX_UPLOAD_MB=10
PALM_RESULT_RETENTION_HOURS=24
MIN_IMAGE_WIDTH=200
MIN_IMAGE_HEIGHT=200
MAX_IMAGE_WIDTH=8000
MAX_IMAGE_HEIGHT=8000