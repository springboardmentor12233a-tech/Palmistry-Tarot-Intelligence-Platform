# ============================================================
# ENVIRONMENT VARIABLES / SECRETS
# ============================================================

.env
.env.local
.env.*.local

backend/.env
backend/.env.local

frontend/.env
frontend/.env.local

# Keep example environment files
!backend/.env.example
!frontend/.env.example


# ============================================================
# PYTHON
# ============================================================

__pycache__/
**/__pycache__/

*.pyc
*.pyo
*.py[cod]

.pytest_cache/

venv/
backend/venv/
backend/.venv/
backend/palm_venv/


# ============================================================
# NODE / FRONTEND
# ============================================================

node_modules/
dist/

frontend/node_modules/
frontend/dist/


# ============================================================
# DATABASES
# ============================================================

*.db
*.db-shm
*.db-wal

*.sqlite
*.sqlite3

backend/app/data/platform.db
backend/app/data/analytics.db
backend/app/data/analytics_legacy_backup.db


# ============================================================
# LOGS
# ============================================================

*.log


# ============================================================
# EDITORS / OPERATING SYSTEM
# ============================================================

.vscode/
.idea/

.DS_Store
Thumbs.db


# ============================================================
# GENERATED BACKEND FILES
# ============================================================

backend/uploads/*
backend/generated/*

!backend/uploads/.gitkeep
!backend/generated/.gitkeep
!backend/generated/palm/.gitkeep
!backend/generated/reports/.gitkeep


# ============================================================
# PALM API GENERATED RESULTS
# ============================================================

backend/app/static/palm_results/*

!backend/app/static/palm_results/.gitkeep


# ============================================================
# EXTERNAL PALMISTRY MODEL
# ============================================================

backend/external/palmistry/code/input/*
backend/external/palmistry/code/results/*

!backend/external/palmistry/code/input/.gitkeep
!backend/external/palmistry/code/results/.gitkeep

backend/external/palmistry/code/input/api_*
backend/external/palmistry/code/results/api_*.json


# ============================================================
# PALM MODEL CHECKPOINTS
# ============================================================

backend/external/palmistry/code/checkpoint/*.pth
backend/external/palmistry/code/checkpoint/*.pt
backend/external/palmistry/code/checkpoint/*.ckpt