# =================================================================
# Palmistry & Tarot Intelligence Platform — Environment Configuration
# Copy this file to .env and replace placeholder values with your secrets.
# NEVER commit your actual .env file to git!
# =================================================================

# Server & Runtime
ENVIRONMENT=production
DEBUG=False
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated or JSON array)
# Include your production frontend domain (e.g. Vercel / Netlify / Render)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://palmistry-frontend.vercel.app","https://palmistry-frontend.onrender.com"]

# Database Configuration (PostgreSQL in Production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=palmistry_db

# Async SQLAlchemy URL (used by FastAPI app at runtime)
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_postgres_password_here@localhost:5432/palmistry_db

# Sync SQLAlchemy URL (used by Alembic for running migrations)
SYNC_DATABASE_URL=postgresql://postgres:your_secure_postgres_password_here@localhost:5432/palmistry_db

# Security & Authentication (JWT)
# Generate a secure 64+ char random string for JWT_SECRET
JWT_SECRET=generate-a-super-secret-random-jwt-key-for-production-min-32-chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Groq LLM API Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Asset Storage Paths (relative or absolute)
ASSETS_DIR=assets
TAROT_DATA_PATH=assets/tarot-images.json
TAROT_CARDS_DIR=assets/cards
PALM_UNET_CHECKPOINT=assets/checkpoint_aug_epoch70.pth
HAND_LANDMARKER_PATH=assets/hand_landmarker.task
OUTPUT_DIR=results
