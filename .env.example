# Copy this file to .env and fill in real values. Never commit .env itself.

# Get a fresh key from https://aistudio.google.com/apikey — rotate the one
# that was hardcoded in your notebooks before using it anywhere.
GEMINI_API_KEY=your-gemini-api-key-here

# Path to your tarot deck JSON (tarot-images.json)
TAROT_DECK_PATH=data/tarot-images.json

# Path to your palmistry-main code directory (the one with input/, results/,
# and checkpoint/checkpoint_aug_epoch70.pth). Defaults to the copy bundled
# in this project at palmistry-main/code — override if yours lives elsewhere.
PALMISTRY_CODE_DIR=palmistry-main/code

# Comma-separated list of origins allowed to call the API (use * for local dev only)
ALLOWED_ORIGINS=*

# Used by the Streamlit frontend to reach the API
API_URL=http://localhost:8000
